#!/bin/bash

usage() {
    printf 'Usage: %s -o ORGANIZATION [-t TEAM_SLUG]\n' "${0##*/}"
    printf 'Run gh auth login to authorize repository listing. New checkouts use SSH.\n'
}

org=
team=
while getopts ':ho:t:' option; do
    case "$option" in
        h) usage; exit 0 ;;
        o) org=$OPTARG ;;
        t) team=$OPTARG ;;
        *) usage >&2; exit 2 ;;
    esac
done
shift "$((OPTIND - 1))"

if [[ -z $org || $# -gt 0 ]]; then
    usage >&2
    exit 2
fi

for program in gh git; do
    if ! command -v "$program" >/dev/null; then
        printf 'Install %s to use %s.\n' "$program" "${0##*/}" >&2
        exit 127
    fi
done

endpoint="orgs/$org/repos"
if [[ -n $team ]]; then
    endpoint="orgs/$org/teams/$team/repos"
fi

repositories=$(gh api --hostname github.com --paginate "$endpoint?per_page=100" \
    --jq '.[] | [.name, .ssh_url, .clone_url] | @tsv') || exit "$?"
if [[ -z $repositories ]]; then
    printf 'No repositories found.\n'
    exit 0
fi

status=0
while IFS=$'\t' read -r name ssh_url https_url; do
    directory="./$name"
    if [[ ! -e $directory && ! -L $directory ]]; then
        printf 'Cloning %s\n' "$ssh_url"
        git clone -- "$ssh_url" "$directory" || status=1
        continue
    fi

    if [[ ! -e $directory/.git ]] || ! origin=$(git -C "$directory" config --local --get remote.origin.url); then
        printf 'Skipping %s because it is not a checkout with an origin.\n' "$directory" >&2
        status=1
        continue
    fi

    ssh_scheme_url="ssh://${ssh_url/:/\/}"
    case "${origin%.git}" in
        "${ssh_url%.git}"|"${ssh_scheme_url%.git}"|"${https_url%.git}")
            printf 'Updating %s\n' "$directory"
            git -C "$directory" pull --ff-only || status=1
            ;;
        *)
            printf 'Skipping %s because its origin does not match %s.\n' "$directory" "$ssh_url" >&2
            status=1
            ;;
    esac
done <<< "$repositories"
exit "$status"
