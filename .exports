# Add `~/bin` to the `$PATH`
[[ -d "/usr/local/sbin" ]] && export PATH="/usr/local/sbin:$PATH";
[[ -d "$HOME/bin" ]] && export PATH="$HOME/bin:$PATH";

_dotfiles_shell=bash
[[ -n "${ZSH_VERSION:-}" ]] && _dotfiles_shell=zsh
if command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv "$_dotfiles_shell")"
elif [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv "$_dotfiles_shell")"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv "$_dotfiles_shell")"
fi
unset _dotfiles_shell

# Allow machine-local PATH additions before the standard tool directories.
if [[ -r "$HOME/.path" && -f "$HOME/.path" ]]; then
  source "$HOME/.path"
fi

# Make vim the default editor.
export EDITOR='vim';

# Make Python use UTF-8 encoding for output to stdin, stdout, and stderr.
export PYTHONIOENCODING='UTF-8';

if [[ -n "${BASH_VERSION:-}" ]]; then
  export HISTSIZE=32768 HISTFILESIZE=32768 HISTCONTROL=ignoreboth
fi

# Prefer US English and use UTF-8.
export LANG='en_US.UTF-8';
export LC_ALL='en_US.UTF-8';

#Lets add some colour to the termnial window
export CLICOLOR=1
export LSCOLORS=GxFxCxDxBxegedabagaced

# Give Maven dinner as it is hungry
export MAVEN_OPTS="-Xms2048m"

# Go env settings
export GOPATH="$HOME/dev/go-workspace"
[[ -d "$GOPATH/bin" ]] && export PATH="$GOPATH/bin:$PATH";

# Prefer GNU sed and grep when Homebrew has installed them.
if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
  for gnubin in "$HOMEBREW_PREFIX"/opt/{gnu-sed,grep}/libexec/gnubin; do
    [[ -d "$gnubin" ]] && export PATH="$gnubin:$PATH"
  done
  unset gnubin
fi

export PATH="$HOME/.local/bin:$PATH"

# Keep the first occurrence of each entry, including any empty entry.
_dotfiles_dedupe_path() {
  local remaining="$PATH:" entry result=:
  while [[ $remaining == *:* ]]; do
    entry=${remaining%%:*}
    remaining=${remaining#*:}
    case $result in
      *":$entry:"*) ;;
      *) result="$result$entry:" ;;
    esac
  done
  result=${result#:}
  export PATH="${result%:}"
}

_dotfiles_starship_config() {
  [[ -z "${STARSHIP_CONFIG:-}" ]] || return 0
  local config
  for config in "${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml" \
    "$HOME/.config/starship.toml" "$HOME/.config/dotfiles/starship.toml"; do
    if [[ -f "$config" && -r "$config" ]]; then
      export STARSHIP_CONFIG="$config"
      return 0
    fi
  done
}
